# Application
APP_NAME=Affiliate Platform API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
POSTGRES_USER=affiliate
POSTGRES_PASSWORD=affiliate_secret
POSTGRES_DB=affiliate_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://affiliate:affiliate_secret@db:5432/affiliate_db

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Telegram Bot API (optional — enables live permission checks)
TELEGRAM_BOT_TOKEN=8062353434:AAEaycam01uDoBG6k4l3SWPRALk87i6QeTQ
TELEGRAM_API_BASE_URL=https://api.telegram.org

# AI Content Generation
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=AIzaSyAFmQmpRYWJF3dW3XDntnntw15EBVCVZhw
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_PUBLISH_INTERVAL_SECONDS=60
CELERY_PUBLISH_BATCH_SIZE=50

# AliExpress Affiliate API
ALIEXPRESS_APP_KEY=515484
ALIEXPRESS_APP_SECRET=Brg8l34ARmIHNzxcYwJv8dlOaK2q3208
ALIEXPRESS_TRACKING_ID=cursor_bot
ALIEXPRESS_API_URL=https://api-sg.aliexpress.com/sync
#ALIEXPRESS_API_URL=https://api-sg.aliexpress.com/rest
ALIEXPRESS_TARGET_CURRENCY=USD
ALIEXPRESS_TARGET_LANGUAGE=EN
ALIEXPRESS_COUNTRY=IL
ALIEXPRESS_REQUEST_TIMEOUT=30.0
ALIEXPRESS_MAX_RETRIES=3
ALIEXPRESS_RETRY_BACKOFF_SECONDS=0.5
ALIEXPRESS_RATE_LIMIT_INTERVAL_SECONDS=0.2
ALIEXPRESS_SMARTMATCH_DEVICE_ID=affiliate-platform-discovery
ALIEXPRESS_ENABLE_DS_IMAGE_SEARCH=false
ALIEXPRESS_DISCOVERY_REFRESH_BATCH_SIZE=50
ALIEXPRESS_DISCOVERY_REFRESH_MAX_PAGES=2
CELERY_DISCOVERY_HOT_INTERVAL_SECONDS=21600
CELERY_DISCOVERY_TRENDING_INTERVAL_SECONDS=21600
CELERY_DISCOVERY_CATEGORIES_INTERVAL_SECONDS=86400
